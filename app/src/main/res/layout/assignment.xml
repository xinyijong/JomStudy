<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardElevation="5dp"
    app:cardCornerRadius="8dp"
    android:layout_margin="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Assignment Title and Due Date -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/group_28"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/assignmentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assignment Title"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_toEndOf="@id/icon"
            android:layout_marginStart="10dp"
            android:layout_alignTop="@id/icon" />

        <TextView
            android:id="@+id/dueDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Date"
            android:textSize="14sp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/assignmentTitle"
            android:layout_marginEnd="10dp" />

        <!-- Course Code and Course Name -->
        <TextView
            android:id="@+id/courseCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Course Code"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_below="@id/assignmentTitle"
            android:layout_alignStart="@id/assignmentTitle"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/courseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Course Name"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_toEndOf="@id/courseCode"
            android:layout_alignBaseline="@id/courseCode"
            android:layout_marginStart="8dp" />

        <!-- Current Progress and Status -->
        <TextView
            android:id="@+id/progressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Progress:"
            android:layout_below="@id/courseCode"
            android:layout_alignStart="@id/courseCode"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XX %"
            android:textColor="@color/green"
            android:textStyle="bold"
            android:layout_toEndOf="@id/progressLabel"
            android:layout_alignBaseline="@id/progressLabel"
            android:layout_marginStart="3dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not completed"
            android:layout_alignBaseline="@id/progress"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
